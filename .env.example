PORT=3000

# La clave de invitacion ya no vive aqui: el servidor la pide por terminal
# en cada arranque (npm start / npm run tunnel) y nunca se escribe en disco.
# Solo si necesitas un arranque 100% no interactivo (systemd, Docker, CI),
# puedes fijarla aqui o como variable de entorno; en ese caso NO se te
# pedira por pantalla:
# INVITE_CODE=pon-aqui-tu-clave
